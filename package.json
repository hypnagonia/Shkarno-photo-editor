{
  "name": "image-improver2",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "build:libraw": "bash native/libraw/build.sh",
    "build:cpu": "wasm-pack build native/cpu --target web --out-dir ../../src/cpu/pkg --release && rm -f src/cpu/pkg/.gitignore",
    "predev": "node scripts/copy-ort.mjs",
    "prebuild": "node scripts/copy-ort.mjs",
    "memcheck": "node scripts/memcheck.mjs",
    "deploy": "npm run build && node scripts/memcheck.mjs --no-build && npx vercel deploy --prod --yes"
  },
  "dependencies": {
    "libheif-js": "^1.19.8",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "@webgpu/types": "^0.1.74",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  }
}
